#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
    chosen {
        // Tells Zephyr's display sub-system (and graphics engines like LVGL) to target this screen
        zephyr,display = &ili9341_lcd;
    };

    // Virtual MIPI-DBI bus required by modern Zephyr display drivers
    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi2>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;

        // Hardware control pins managed directly by the MIPI-DBI wrapper
        dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;    /* D/C (Data/Command) Pin */
        reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;  /* RST (Reset) Pin */

        ili9341_lcd: ili9341@0 {
            compatible = "ilitek,ili9341";
            mipi-max-frequency = <25000000>;
            reg = <0>;
            pixel-format = <1>;
            rotation = <90>;
            h-mirror;
            width = <240>;
            height = <320>;
            status = "okay";
        };
    };
};

&dma {
    status = "okay";
};

&pinctrl {
    spi2_custom: spi2_custom {
        group1 {
            pinmux = <SPIM2_SCLK_GPIO12>,
                     <SPIM2_MISO_GPIO13>,
                     <SPIM2_CSEL_GPIO10>;
        };
        group2 {
            pinmux = <SPIM2_MOSI_GPIO11>;
            output-low;
        };
    };
};

&spi2 {
    status = "okay";
    pinctrl-0 = <&spi2_custom>;
    pinctrl-names = "default";
    dmas = <&dma 0>, <&dma 1>;
    dma-names = "tx", "rx";
};
